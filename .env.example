# Copy to .env and adjust. Every feature flag defaults off.

# Base URL of the local Ollama instance.
OLLAMA_HOST=http://localhost:11434

# Timeout (ms) for calls to Ollama's /api/generate and /api/tags.
OLLAMA_TIMEOUT_MS=120000

# Enables every experimental group below. A group-specific 0 overrides it.
# This never enables the autonomous Git-writing workers.
ENABLE_EXPERIMENTAL=0

# Experimental Explorer groups. Prefer enabling only the capability needed.
ENABLE_SEMANTIC_SEARCH=0
ENABLE_GIT_HISTORY=0
ENABLE_KNOWLEDGE_STORE=0
ENABLE_VERIFICATION_PIPELINE=0
# Requires ENABLE_VERIFICATION_PIPELINE=1.
ENABLE_FULL_EXPLORER=0
ENABLE_LOCAL_EXPLORER_TASK=0
ENABLE_FRAMEWORK_ADAPTERS=0

# Enables run_local_worker_task (autonomous git status/diff/log/add/commit/show
# via a local Ollama model, no confirmation prompts). Requires `ollama` running
# locally with a model that emits real tool_calls - qwen3.5:4b is confirmed to
# work, qwen2.5-coder:3b is not. See docs/local-claude-worker-experiment-2026-09-14.md.
LOCAL_WORKER_ENABLED=0

# Enables run_cloud_claude_task (same allowlist, but runs the full Claude Code
# harness via `ollama launch claude` against an Ollama *cloud* model). Requires
# the 'ollama launch claude' feature installed and `ollama signin` already done.
CLOUD_CLAUDE_ENABLED=0
